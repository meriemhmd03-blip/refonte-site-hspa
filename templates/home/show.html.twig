{% extends 'base.html.twig' %}

{% block title %}{{ prestation.nom }} | Head Spa Lyon By F.{% endblock %}

{% block body %}

<!-- ========== HERO ========== -->

<header class="hero hero-prestation">

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <span class="hero-eyebrow">
    {{ prestation.heroSousTitre }}
</span>

<h1>
    {{ prestation.nom }}<br>
    <em>Lyon</em>
</h1>

<div class="prestation-infos">

    <span>⏱ {{ prestation.duree }} min</span>

    <span>💎 {{ prestation.prix }} €</span>

</div>

<p class="hero-sub">
    {{ prestation.heroDescription }}
</p>

<a href="{{ path('app_reservation', { id: prestation.id }) }}"
   class="btn">
    Réserver un soin
</a>

    </div>

</header>

<!-- ========== INTRO ========== -->

<section class="intro fade">

    <div class="container">

        <span class="section-label">
            Le soin
        </span>

        <h2>
            {{ prestation.nom }}
        </h2>

        <div class="divider"></div>

        <p>
            {{ prestation.introduction }}
        </p>

    </div>

</section>

<!-- ========== TECHNIQUE ========== -->

<section class="section-duo fade">

    <div class="container duo-inner">

        <div class="section-text">

            <span class="section-label">
                La technique
            </span>

            <h2>
                Comment fonctionne {{ prestation.nom }} ?
            </h2>

            <p>
                {{ prestation.technique }}
            </p>

        </div>

        <div class="section-image">

            <img
                loading="lazy"
                src="{{ asset('images/' ~ prestation.imageTechnique) }}"
                alt="{{ prestation.nom }}"
            >

        </div>

    </div>

</section>

<!-- ========== RESULTATS ========== -->

<section class="section-duo-alt fade">

    <div class="container duo-inner">

        <div class="section-image">

            <img
                loading="lazy"
                src="{{ asset('images/' ~ prestation.imageResultats) }}"
                alt="{{ prestation.nom }}"
            >

        </div>

        <div class="section-text">

            <span class="section-label">
                Les résultats
            </span>

            <h2>
                Les résultats de {{ prestation.nom }}
            </h2>

            <p>
                {{ prestation.resultats }}
            </p>

        </div>

    </div>

</section>

<!-- ========== BIENFAITS ========== -->

<section class="bienfaits fade">

    <div class="container">

        <div class="bienfaits-header">

            <span class="section-label">
                Les bienfaits
            </span>

            <h2>
                Pourquoi choisir {{ prestation.nom }} ?
            </h2>

        </div>

        <div class="bienfaits-grid">

            {% for bienfait in prestation.bienfaits %}

                <div class="bienfait-card">

                    <i class="{{ bienfait.icone }}"></i>

                    <h3>
                        {{ bienfait.titre }}
                    </h3>

                    <p>
                        {{ bienfait.description }}
                    </p>

                </div>

            {% endfor %}

        </div>

    </div>

</section>

<!-- ========== CTA PREMIUM ========== -->

<section class="cta-luxe">

    <div class="cta-overlay"></div>

    <div class="cta-content">

        <span class="section-label">
            Votre moment de bien-être
        </span>

        <h2>
            Prête à vivre l'expérience {{ prestation.nom }} ?
        </h2>

        <p>
            Réservez votre séance et laissez-vous porter par un véritable rituel de détente inspiré des traditions japonaises.
        </p>

        <a href="{{ path('app_reservation', { id: prestation.id }) }}"
           class="btn">
            Réserver maintenant
        </a>

    </div>

</section>

{% endblock %}