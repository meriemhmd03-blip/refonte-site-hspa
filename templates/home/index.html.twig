{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

<section class="hero">

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <span class="hero-subtitle">
            HEAD SPA • VILLEURBANNE
        </span>

        <h1>
            Head Spa Lyon
            <span>By F.</span>
        </h1>

        <p>
            Offrez-vous une véritable parenthèse de sérénité.
            Inspirés des rituels japonais, nos soins vous invitent
            à ralentir, respirer et retrouver un profond bien-être.
        </p>

        <a href="{{ path('app_reservation_choix') }}" class="hero-btn">
            Réserver un soin
        </a>

    </div>

</section>

<section class="philosophie">

    <div class="container philosophie-grid">

        <div class="philosophie-image">

            <img src="{{ asset('images/philosophie.jpg') }}"
                 alt="Head Spa Lyon">

        </div>

        <div class="philosophie-content">

            <span class="section-label">
                Notre philosophie
            </span>

            <h2>
                Bienvenue chez
                <em>Head Spa Lyon By F.</em>
            </h2>

            <p>
                Chaque soin est pensé comme un véritable voyage sensoriel.
                Inspirés des rituels japonais, nos protocoles associent
                relaxation profonde, expertise et bien-être.
            </p>

            <p>
                Notre objectif est simple : vous offrir un moment hors du
                temps, où le corps et l'esprit retrouvent équilibre,
                sérénité et énergie.
            </p>

        </div>

    </div>

</section>

<section class="prestations-home">

    <div class="container">

        <span class="section-label">
            Nos soins
        </span>

        <h2>
            Découvrez nos expériences Head Spa
        </h2>

        <div class="prestations-grid">

            {% for prestation in prestations %}

                <article class="prestation-card">

                    <img
                        src="{{ asset('images/' ~ prestation.heroImage) }}"
                        alt="{{ prestation.nom }}"
                    >

                    <div class="card-content">

                        <h3>{{ prestation.nom }}</h3>

                        <p>{{ prestation.duree }} minutes</p>

                        <span>
                            <i class="bi bi-gem"></i>
                            {{ prestation.prix }} €
                        </span>

                        <a href="{{ path('prestation_show',{
                            slug: prestation.slug
                        }) }}">
                            Découvrir →
                        </a>

                    </div>

                </article>

            {% endfor %}

        </div>

    </div>

</section>

<section class="why">

    <div class="container">

        <span class="section-label">
            Pourquoi nous choisir
        </span>

        <h2>
            Une expérience pensée pour votre bien-être
        </h2>

        <div class="why-grid">

            <div class="why-card">

                <div class="why-icon">
                    <i class="bi bi-flower1"></i>
                </div>

                <h3>Produits premium</h3>

                <p>
                    Des soins sélectionnés pour respecter le cuir chevelu et sublimer les cheveux.
                </p>

            </div>

            <div class="why-card">

                <div class="why-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>

                <h3>Expertise Head Spa</h3>

                <p>
                    Des techniques inspirées des rituels japonais pour une relaxation profonde.
                </p>

            </div>

            <div class="why-card">

                <div class="why-icon">
                    <i class="bi bi-stars"></i>
                </div>

                <h3>Moment hors du temps</h3>

                <p>
                    Une parenthèse de douceur pour ralentir, respirer et retrouver votre énergie.
                </p>

            </div>

            <div class="why-card">

                <div class="why-icon">
                    <i class="bi bi-heart"></i>
                </div>

                <h3>Accompagnement personnalisé</h3>

                <p>
                    Chaque soin est adapté à vos besoins et à votre cuir chevelu.
                </p>

            </div>

        </div>

    </div>

</section>

<section class="avis">

    <div class="container">

        <span class="section-label">
            Elles nous font confiance
        </span>

        <h2>
            Les avis de nos clientes
        </h2>

        <div class="avis-grid">

            <div class="avis-card">

                <div class="stars">★★★★★</div>

                <p>
                    Une expérience incroyable. Dès les premières minutes,
                    je me suis sentie totalement détendue.
                    Je recommande à 100 %.
                </p>

                <strong>— Sarah</strong>

            </div>

            <div class="avis-card">

                <div class="stars">★★★★★</div>

                <p>
                    Le meilleur Head Spa que j'ai testé.
                    Un moment hors du temps avec une vraie expertise.
                </p>

                <strong>— Camille</strong>

            </div>

            <div class="avis-card">

                <div class="stars">★★★★★</div>

                <p>
                    Une atmosphère incroyable, des soins de qualité
                    et une sensation de bien-être qui dure plusieurs jours.
                </p>

                <strong>— Inès</strong>

            </div>

        </div>

    </div>

</section>

<section class="final-cta fade">

    <div class="final-overlay"></div>

    <div class="container">

        <div class="final-content">

            <span class="section-label">
                Head Spa Lyon By F.
            </span>

            <h2>

                Offrez-vous un moment<br>
                rien que pour vous.

            </h2>

            <p>

                Chaque soin est une invitation à ralentir,
                respirer et retrouver un profond bien-être.

            </p>

            <a href="{{ path('app_reservation_choix') }}"
               class="btn">

                Réserver un soin

            </a>

        </div>

    </div>

</section>

{% endblock %}