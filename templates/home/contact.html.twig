{% extends 'base.html.twig' %}

{% block title %}Contact | Head Spa Lyon By F.{% endblock %}

{% block body %}

<section class="contact-page">

    <div class="container">

        <div class="contact-header">

            <span class="section-label">
                Contact
            </span>

            <h1>
                Une parenthèse de bien-être vous attend
            </h1>

            <p>
                Une question ? Envie d'un renseignement avant votre réservation ?
                Je serai ravie de vous répondre.
            </p>

        </div>

        <div class="contact-grid">

            <div class="contact-info">

    <div class="info-item">
        <h3>
            <i class="bi bi-geo-alt"></i>
            Adresse
        </h3>
        <p>Villeurbanne - Lyon</p>
    </div>

    <div class="info-item">
        <h3>
            <i class="bi bi-telephone"></i>
            Téléphone
        </h3>
        <p>06 XX XX XX XX</p>
    </div>

    <div class="info-item">
        <h3>
            <i class="bi bi-envelope"></i>
            Email
        </h3>
        <p>contact@headspalyonbyf.fr</p>
    </div>

    <div class="info-item">
        <h3>
            <i class="bi bi-instagram"></i>
            Instagram
        </h3>
        <p>@headspalyonbyf</p>
    </div>

    <div class="info-item">
        <h3>
            <i class="bi bi-clock"></i>
            Horaires
        </h3>
        <p>Lundi au Samedi<br>9h00 - 19h00</p>
    </div>

</div>

            </div>

            <div class="contact-map">

                <iframe
                    src="https://www.google.com/maps?q=Villeurbanne&output=embed"
                    loading="lazy">
                </iframe>

            </div>

        </div>

    </div>

</section>

{% endblock %}