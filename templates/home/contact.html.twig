{% extends 'base.html.twig' %}

{% block title %}Contact | Head Spa Lyon By F.{% endblock %}

{% block body %}

<section class="contact-page">

    <div class="contact-container">

        {# ================= HEADER ================= #}

        <div class="contact-header">

            <span class="section-label">
                Contact
            </span>

            <h1>
                Une parenthèse de
                <em>bien-être.</em>
            </h1>

            <p>
                Une question avant votre réservation ?
                Je serai ravie de vous accompagner et de répondre
                à toutes vos demandes.
            </p>

        </div>


        {# ================= CONTENU ================= #}

        <div class="contact-grid">


            {# ================= INFORMATIONS ================= #}

            <div class="contact-card">

                <div class="contact-card-top"></div>

                <div class="contact-info">


                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-geo-alt"></i>
                        </div>

                        <div>
                            <span>Adresse</span>
                            <p>Villeurbanne — Lyon</p>
                        </div>

                    </div>


                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-telephone"></i>
                        </div>

                        <div>
                            <span>Téléphone</span>
                            <p>06 XX XX XX XX</p>
                        </div>

                    </div>


                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-envelope"></i>
                        </div>

                        <div>
                            <span>Email</span>
                            <p>contact@headspalyon.fr</p>
                        </div>

                    </div>


                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-instagram"></i>
                        </div>

                        <div>
                            <span>Instagram</span>
                            <p>@headspalyon</p>
                        </div>

                    </div>


                    <div class="contact-item">

                        <div class="contact-icon">
                            <i class="bi bi-clock"></i>
                        </div>

                        <div>
                            <span>Horaires</span>
                            <p>
                                Lundi au Samedi<br>
                                9h00 — 19h00
                            </p>
                        </div>

                    </div>

                </div>

            </div>


            {# ================= CARTE ================= #}

            <div class="contact-map-card">

                <div class="contact-map-header">

                    <span class="section-label">
                        Nous trouver
                    </span>

                    <h2>
                        Le Head Spa
                        <em>vous attend.</em>
                    </h2>

                    <p>
                        Retrouvez-nous à Villeurbanne,
                        aux portes de Lyon.
                    </p>

                </div>


                <div class="contact-map">

                    <iframe
                        src="https://www.google.com/maps?q=Villeurbanne&output=embed"
                        loading="lazy"
                        allowfullscreen>
                    </iframe>

                </div>

            </div>

        </div>

    </div>

</section>

{% endblock %}