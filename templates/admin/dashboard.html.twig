{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}

<h1>📊 Tableau de bord</h1>

<p>Bienvenue dans l'administration du Head Spa.</p>

<hr>

<h2>Statistiques</h2>

<p>
    Nombre total de rendez-vous :
    <strong>{{ nombreRendezVous }}</strong>
</p>

<p>
    Rendez-vous aujourd'hui :
    <strong>{{ nombreAujourdHui }}</strong>
</p>

<p>
    🟡 En attente :
    <strong>{{ nombreEnAttente }}</strong>
</p>

<p>
    🟢 Confirmés :
    <strong>{{ nombreConfirmes }}</strong>
</p>

<p>
    🔴 Annulés :
    <strong>{{ nombreAnnules }}</strong>
</p>
<hr>

<h2>📅 Rendez-vous d'aujourd'hui</h2>

{% if rendezVousAujourdHui is empty %}

    <p>Aucun rendez-vous aujourd'hui.</p>

{% else %}

    <table class="table">

        <thead>
            <tr>
                <th>Heure</th>
                <th>Client</th>
                <th>Prestation</th>
                <th>Statut</th>
            </tr>
        </thead>

        <tbody>

        {% for rendezVous in rendezVousAujourdHui %}

            <tr>

                <td>
                    {{ rendezVous.dateHeure|date('H:i') }}
                </td>

                <td>
                    {{ rendezVous.user.prenom }}
                    {{ rendezVous.user.nom }}
                </td>

                <td>
                    {{ rendezVous.prestation.nom }}
                </td>

                <td>
                    {{ rendezVous.statut }}
                </td>

            </tr>

        {% endfor %}

        </tbody>

    </table>

{% endif %}
<hr>

<h2>📅 Prochains rendez-vous</h2>

{% if prochainsRendezVous is empty %}

    <p>Aucun rendez-vous à venir.</p>

{% else %}

    <table class="table">

        <thead>

            <tr>

                <th>Date</th>

                <th>Client</th>

                <th>Prestation</th>

            </tr>

        </thead>

        <tbody>

        {% for rendezVous in prochainsRendezVous %}

            <tr>

                <td>

                    {{ rendezVous.dateHeure|date('d/m/Y H:i') }}

                </td>

                <td>

                    {{ rendezVous.user.prenom }}
                    {{ rendezVous.user.nom }}

                </td>

                <td>

                    {{ rendezVous.prestation.nom }}

                </td>

            </tr>

        {% endfor %}

        </tbody>

    </table>

{% endif %}

{% endblock %}