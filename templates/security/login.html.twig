{% extends 'base.html.twig' %}

{% block title %}Connexion | Head Spa Lyon By F.{% endblock %}

{% block body %}

<div class="login-page">

    <div class="login-container">

        <div class="login-header">

            <span class="section-label">
                Votre espace bien-être
            </span>

            <h1>
                Bienvenue
                <em>chez vous.</em>
            </h1>

            <p>
                Connectez-vous pour retrouver votre espace client
                et gérer vos rendez-vous en toute simplicité.
            </p>

        </div>


        <div class="login-card">

            {% if error %}

                <div class="login-error">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>
                        Email ou mot de passe incorrect.
                    </span>
                </div>

            {% endif %}


            {% if app.user %}

                <div class="login-success">
                    Vous êtes connecté en tant que
                    <strong>{{ app.user.userIdentifier }}</strong>.
                </div>

            {% endif %}


            <form method="post">

                <div class="login-field">

                    <label for="username">
                        Adresse email
                    </label>

                    <div class="login-input">

                        <i class="bi bi-envelope"></i>

                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            autocomplete="email"
                            required
                            autofocus
                            placeholder="votre@email.com"
                        >

                    </div>

                </div>


                <div class="login-field">

                    <label for="password">
                        Mot de passe
                    </label>

                    <div class="login-input">

                        <i class="bi bi-lock"></i>

                        <input
                            type="password"
                            name="_password"
                            id="password"
                            autocomplete="current-password"
                            required
                            placeholder="Votre mot de passe"
                        >

                    </div>

                </div>


                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >


                <button
                    class="login-button"
                    type="submit"
                >
                    Se connecter
                    <i class="bi bi-arrow-right"></i>
                </button>

            </form>


            <div class="login-register">

                <span>
                    Vous n'avez pas encore de compte ?
                </span>

                <a href="{{ path('app_register') }}">
                    Créer un compte
                </a>

            </div>

        </div>


        <div class="login-bottom">

            <span></span>

            <i class="bi bi-star"></i>

            <span></span>

        </div>

    </div>

</div>

{% endblock %}