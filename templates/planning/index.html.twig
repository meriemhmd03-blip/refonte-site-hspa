{% extends 'base.html.twig' %}

{% block title %}Planning{% endblock %}

{% block body %}

<div class="container mt-4">

    <h1>📅 Planning de la semaine</h1>

    {% if rendezVous is empty %}

        <p>Aucun rendez-vous cette semaine.</p>

    {% else %}

        <table class="table table-striped">

            <thead>
                <tr>
                    <th>Date</th>
                    <th>Heure</th>
                    <th>Client</th>
                    <th>Prestation</th>
                    <th>Statut</th>
                </tr>
            </thead>

            <tbody>

            {% for rdv in rendezVous %}

                <tr>

                    <td>{{ rdv.dateHeure|date('d/m/Y') }}</td>

                    <td>{{ rdv.dateHeure|date('H:i') }}</td>

                    <td>{{ rdv.user.prenom }} {{ rdv.user.nom }}</td>

                    <td>{{ rdv.prestation.nom }}</td>

                    <td>{{ rdv.statut }}</td>

                </tr>

            {% endfor %}

            </tbody>

        </table>

    {% endif %}

</div>

{% endblock %}