{% extends 'base.html.twig' %}

{% block title %}Mon espace{% endblock %}

{% block body %}

<section class="account">

    <div class="container">

        <div class="account-header">

            <span class="section-label">
                Espace client
            </span>

            <h1>
                Bonjour {{ app.user.prenom }} 👋
            </h1>
            <div class="stats-grid">

    <div class="stat-card">
        <h3>{{ totalRdv }}</h3>
        <span>Rendez-vous</span>
    </div>

    <div class="stat-card">
        <h3>{{ confirmes }}</h3>
        <span>Confirmés</span>
    </div>

    <div class="stat-card">
        <h3>{{ attente }}</h3>
        <span>En attente</span>
    </div>

    <div class="stat-card">
        <h3>{{ annules }}</h3>
        <span>Annulés</span>
    </div>

</div>

            <p>
                Retrouvez vos informations personnelles ainsi que vos prochains rendez-vous.
            </p>

        </div>

        <div class="account-grid">

            <div class="info-card">

                <h3>Nom</h3>

                <p>{{ app.user.nom }}</p>

            </div>

            <div class="info-card">

                <h3>Prénom</h3>

                <p>{{ app.user.prenom }}</p>

            </div>

            <div class="info-card">

                <h3>Email</h3>

                <p>{{ app.user.email }}</p>

            </div>

            <div class="info-card">

                <h3>Téléphone</h3>

                <p>{{ app.user.telephone }}</p>

            </div>

        </div>

        <div class="account-actions">

            <a href="{{ path('app_account_edit') }}" class="btn">
                Modifier mes informations
            </a>

        </div>

        <div class="rdv-title">

            <span class="section-label">
                Mes réservations
            </span>

            <h2>
                Mes rendez-vous
            </h2>

        </div>

        {% if rendezVous is empty %}

            <div class="empty-card">

                <h3>Aucun rendez-vous</h3>

                <p>
                    Vous n'avez encore effectué aucune réservation.
                </p>

                <a href="{{ path('app_reservation_choix') }}" class="btn">
                    Réserver un soin
                </a>

            </div>

        {% else %}

            <div class="rdv-grid">

                {% for rdv in rendezVous %}

                    <div class="rdv-card">

                        <h3>{{ rdv.prestation.nom }}</h3>

                        <p>
                            📅 {{ rdv.dateHeure|date('d/m/Y') }}
                        </p>

                        <p>
                            🕒 {{ rdv.dateHeure|date('H:i') }}
                        </p>

                        {% if rdv.statut == 'CONFIRME' %}

                            <span class="badge success">
                                Confirmé
                            </span>

                        {% elseif rdv.statut == 'EN_ATTENTE' %}

                            <span class="badge warning">
                                En attente
                            </span>

                        {% elseif rdv.statut == 'REFUSE' %}

                            <span class="badge danger">
                                Refusé
                            </span>

                        {% else %}

                            <span class="badge cancel">
                                Annulé
                            </span>

                        {% endif %}

                        {% if rdv.statut == 'EN_ATTENTE' %}

                            <a
                                href="{{ path('app_annuler_rendez_vous',{id:rdv.id}) }}"
                                class="btn"
                                onclick="return confirm('Voulez-vous vraiment annuler ce rendez-vous ?');">

                                Annuler le rendez-vous

                            </a>

                        {% endif %}

                    </div>

                {% endfor %}

            </div>

        {% endif %}

    </div>

</section>

{% endblock %}