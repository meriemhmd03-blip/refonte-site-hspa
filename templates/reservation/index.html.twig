{% extends 'base.html.twig' %}

{% block title %}Réserver {{ prestation.nom }}{% endblock %}

{% block body %}

<section class="reservation-page">

    <div class="container">

        <div class="reservation-header">

            <span class="section-label">
                Réservation
            </span>

            <h1>
                {{ prestation.nom }}
            </h1>

            <p>
                {{ prestation.heroSousTitre|striptags }}
            </p>

        </div>

        <div class="reservation-box">

           <div class="reservation-info">

    <h2>{{ prestation.nom|striptags }}</h2>

    <p>
        {{ prestation.heroSousTitre|striptags }}
    </p>

    <ul>

        <li>
    <i class="bi bi-clock"></i>
    <strong>Durée :</strong> {{ prestation.duree }} min
</li>

<li>
    <i class="bi bi-gem"></i>
    <strong>Prix :</strong> {{ prestation.prix }} €
</li>

<li>
    <i class="bi bi-envelope"></i>
    Confirmation par email
</li>

<li>
    <i class="bi bi-stars"></i>
    Expérience Head Spa haut de gamme
</li>

    </ul>

</div>

            <div class="reservation-form">

                {{ form_start(form) }}

                    {{ form_row(form.dateHeure) }}

                    <button class="btn reservation-btn">

                        Confirmer ma réservation

                    </button>

                {{ form_end(form) }}

            </div>

        </div>

    </div>

</section>

{% endblock %}