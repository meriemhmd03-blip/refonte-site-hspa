{% extends 'base.html.twig' %}

{% block title %}Réserver {{ prestation.nom }}{% endblock %}

{% block body %}

<section class="reservation-page">

    <div class="container">

        <div class="reservation-header">

            <span class="section-label">
                Réservation
            </span>

            <h1>
                {{ prestation.nom }}
            </h1>

            <p>
                {{ prestation.heroSousTitre }}
            </p>

        </div>

        <div class="reservation-box">

            <div class="reservation-info">

                <h2>Votre soin</h2>

                <p>
                    Choisissez la date et l'heure qui vous conviennent.
                    Votre demande sera ensuite confirmée par email.
                </p>

                <ul>

                    <li>✨ Confirmation par email</li>

                    <li>🕒 Durée : {{ prestation.duree }} min</li>

                    <li>💆 Réservation simple et rapide</li>

                </ul>

            </div>

            <div class="reservation-form">

                {{ form_start(form) }}

                    {{ form_row(form.dateHeure) }}

                    <button class="btn reservation-btn">

                        Confirmer ma réservation

                    </button>

                {{ form_end(form) }}

            </div>

        </div>

    </div>

</section>

{% endblock %}