{% extends 'base.html.twig' %}

{% block title %}Créer un compte | Head Spa Lyon By F.{% endblock %}

{% block body %}

<div class="login-page">

    <div class="login-container">

        {# ================= HEADER ================= #}

        <div class="login-header">

            <span class="section-label">
                Votre espace bien-être
            </span>

            <h1>
                Créez votre
                <em>espace.</em>
            </h1>

            <p>
                Créez votre compte pour réserver vos soins
                et retrouver facilement vos rendez-vous.
            </p>

        </div>


        {# ================= CARTE ================= #}

        <div class="login-card">

            <div class="login-card-top"></div>


            {{ form_errors(registrationForm) }}


            {{ form_start(registrationForm, {
                attr: {
                    class: 'login-form'
                }
            }) }}


                {# NOM #}

                <div class="login-field">

                    {{ form_label(registrationForm.nom, 'Nom') }}

                    <div class="login-input">

                        <i class="bi bi-person"></i>

                        {{ form_widget(registrationForm.nom, {
                            attr: {
                                placeholder: 'Votre nom',
                                autocomplete: 'family-name'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.nom) }}

                </div>


                {# PRÉNOM #}

                <div class="login-field">

                    {{ form_label(registrationForm.prenom, 'Prénom') }}

                    <div class="login-input">

                        <i class="bi bi-person"></i>

                        {{ form_widget(registrationForm.prenom, {
                            attr: {
                                placeholder: 'Votre prénom',
                                autocomplete: 'given-name'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.prenom) }}

                </div>


                {# TÉLÉPHONE #}

                <div class="login-field">

                    {{ form_label(registrationForm.telephone, 'Téléphone') }}

                    <div class="login-input">

                        <i class="bi bi-telephone"></i>

                        {{ form_widget(registrationForm.telephone, {
                            attr: {
                                placeholder: '06 00 00 00 00',
                                autocomplete: 'tel'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.telephone) }}

                </div>


                {# EMAIL #}

                <div class="login-field">

                    {{ form_label(registrationForm.email, 'Adresse email') }}

                    <div class="login-input">

                        <i class="bi bi-envelope"></i>

                        {{ form_widget(registrationForm.email, {
                            attr: {
                                placeholder: 'votre@email.com',
                                autocomplete: 'email'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.email) }}

                </div>


                {# MOT DE PASSE #}

                <div class="login-field">

                    {{ form_label(
                        registrationForm.plainPassword,
                        'Mot de passe'
                    ) }}

                    <div class="login-input">

                        <i class="bi bi-lock"></i>

                        {{ form_widget(registrationForm.plainPassword, {
                            attr: {
                                placeholder: 'Votre mot de passe',
                                autocomplete: 'new-password'
                            }
                        }) }}

                    </div>

                    {{ form_errors(registrationForm.plainPassword) }}

                </div>


                {# CONDITIONS #}

                <div class="register-terms">

                    {{ form_widget(registrationForm.agreeTerms) }}

                    {{ form_label(
                        registrationForm.agreeTerms,
                        "J'accepte les conditions d'utilisation"
                    ) }}

                </div>

                {{ form_errors(registrationForm.agreeTerms) }}


                {# BOUTON #}

                <button
                    class="login-button"
                    type="submit"
                >
                    Créer mon compte
                    <i class="bi bi-arrow-right"></i>
                </button>


            {{ form_end(registrationForm) }}


            {# CONNEXION #}

            <div class="login-register">

                <span>
                    Vous avez déjà un compte ?
                </span>

                <a href="{{ path('app_login') }}">
                    Se connecter
                </a>

            </div>

        </div>


    </div>

</div>

{% endblock %}