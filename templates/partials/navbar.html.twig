<nav class="navbar {% if app.request.attributes.get('_route') != 'home' %}navbar-light{% endif %}">

    <div class="container navbar-container">

        <a href="{{ path('home') }}" class="logo">
    Head Spa <span>Lyon</span>
</a>

        <ul class="menu">

            <li>
                <a href="{{ path('home') }}">Accueil</a>
            </li>

            <li class="dropdown">

                <a href="#">Prestations</a>

                <ul class="dropdown-menu">

                    {% for prestation in prestations|default([]) %}

                        <li>
                            <a href="{{ path('prestation_show',{slug: prestation.slug}) }}">
                                {{ prestation.nom }}
                            </a>
                        </li>

                    {% endfor %}

                </ul>

            </li>

            <li>
                <a href="{{ path('contact') }}">Contact</a>
            </li>

        </ul>

        <div class="menu-right">

            <a href="{{ path('app_reservation_choix') }}" class="btn-nav">
                Réserver
            </a>

            {% if app.user %}

                <a href="{{ path('app_mes_rendez_vous') }}">
                    Mon espace
                </a>

                <a href="{{ path('app_logout') }}">
                    Déconnexion
                </a>

            {% else %}

                <a href="{{ path('app_login') }}">
                    Connexion
                </a>

            {% endif %}

        </div>

    </div>

</nav>