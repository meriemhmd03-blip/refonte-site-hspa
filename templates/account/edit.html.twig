{% extends 'base.html.twig' %}

{% block title %}Modifier mes informations | Head Spa Lyon By F.{% endblock %}

{% block body %}

<div class="login-page">

    <div class="login-container">

        {# ================= HEADER ================= #}

        <div class="login-header">

            <span class="section-label">
                Votre espace
            </span>

            <h1>
                Modifier mes
                <em>informations.</em>
            </h1>

            <p>
                Gardez vos informations personnelles à jour
                pour faciliter la gestion de vos rendez-vous.
            </p>

        </div>


        {# ================= CARTE ================= #}

        <div class="login-card">

            <div class="login-card-top"></div>


            {{ form_start(form, {
                attr: {
                    class: 'login-form'
                }
            }) }}


                {# NOM #}

                <div class="login-field">

                    {{ form_label(form.nom, 'Nom') }}

                    <div class="login-input">

                        <i class="bi bi-person"></i>

                        {{ form_widget(form.nom, {
                            attr: {
                                placeholder: 'Votre nom',
                                autocomplete: 'family-name'
                            }
                        }) }}

                    </div>

                    {{ form_errors(form.nom) }}

                </div>


                {# PRÉNOM #}

                <div class="login-field">

                    {{ form_label(form.prenom, 'Prénom') }}

                    <div class="login-input">

                        <i class="bi bi-person"></i>

                        {{ form_widget(form.prenom, {
                            attr: {
                                placeholder: 'Votre prénom',
                                autocomplete: 'given-name'
                            }
                        }) }}

                    </div>

                    {{ form_errors(form.prenom) }}

                </div>


                {# TÉLÉPHONE #}

                <div class="login-field">

                    {{ form_label(form.telephone, 'Téléphone') }}

                    <div class="login-input">

                        <i class="bi bi-telephone"></i>

                        {{ form_widget(form.telephone, {
                            attr: {
                                placeholder: '06 00 00 00 00',
                                autocomplete: 'tel'
                            }
                        }) }}

                    </div>

                    {{ form_errors(form.telephone) }}

                </div>


                {# EMAIL #}

                <div class="login-field">

                    {{ form_label(form.email, 'Adresse email') }}

                    <div class="login-input">

                        <i class="bi bi-envelope"></i>

                        {{ form_widget(form.email, {
                            attr: {
                                placeholder: 'votre@email.com',
                                autocomplete: 'email'
                            }
                        }) }}

                    </div>

                    {{ form_errors(form.email) }}

                </div>


                {# BOUTON #}

                <button
                    class="login-button"
                    type="submit"
                >
                    Enregistrer mes informations
                    <i class="bi bi-arrow-right"></i>
                </button>


            {{ form_end(form) }}


            {# RETOUR #}

            <div class="login-register">

                <a href="{{ path('app_mes_rendez_vous') }}">
                    Retour à mon espace
                </a>

            </div>

        </div>


        {# ================= BAS ================= #}

        
    </div>

</div>

{% endblock %}